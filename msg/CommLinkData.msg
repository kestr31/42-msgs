# Per-link communication state from 42 simulator
float64 doppler            # Carrier frequency shift [Hz]
float64 delay              # Signal delay [s]
float64 carrier            # Transmit power [dBw]
float64 cnr                # Carrier-to-Noise Ratio [dB]
float64 range              # Link range [m]
float64 range_rate         # Range rate [m/s]
bool path_is_occulted      # Link blocked by occultation
